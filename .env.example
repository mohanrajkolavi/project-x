# Public address of the site. Used for links in emails, the feed and the sitemap.
SITE_URL=http://localhost:3000

# Where the SQLite database lives (default: ./data/newsletter.db).
# DATABASE_PATH=/var/lib/newsletter/newsletter.db

# SMTP server for sending. Leave empty and every email goes to the admin outbox instead.
# These override the values saved in Admin › Settings.
# MAIL_FROM=hello@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Secret for hashing visitors. Made and stored automatically if unset.
# APP_SECRET=
